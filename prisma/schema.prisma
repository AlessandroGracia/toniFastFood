generator client {
  provider = "prisma-client-js"
  output   = "../packages/db/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum DeviceType {
  POS
  KDS
  ADMIN
  PRINTER
  WORKER
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum BranchAccessLevel {
  VIEW
  OPERATE
  MANAGE
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTE
}

enum InventoryMovementStatus {
  POSTED
  VOIDED
  REVERSED
}

model Tenant {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique @db.VarChar(80)
  name            String             @db.VarChar(160)
  legalName       String?            @map("legal_name") @db.VarChar(220)
  status          TenantStatus       @default(ACTIVE)
  defaultCurrency String             @default("USD") @map("default_currency") @db.Char(3)
  defaultTimezone String             @default("America/Guayaquil") @map("default_timezone") @db.VarChar(80)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches        Branch[]
  devices         Device[]
  memberships     TenantMembership[]
  roles           Role[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]
  categories      Category[]
  products        Product[]
  productVariants ProductVariant[]
  inventoryItems  InventoryItem[]
  inventoryMovements InventoryMovement[]

  @@index([status])
  @@map("tenants")
}

model Branch {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  code         String         @db.VarChar(48)
  name         String         @db.VarChar(160)
  status       BranchStatus   @default(ACTIVE)
  timezone     String         @default("America/Guayaquil") @db.VarChar(80)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  devices      Device[]
  branchAccess BranchAccess[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("branches")
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique @db.VarChar(255)
  displayName  String             @map("display_name") @db.VarChar(160)
  status       UserStatus         @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  TenantMembership[]

  @@index([status])
  @@map("users")
}

model TenantMembership {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAccess   BranchAccess[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_memberships")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  key             String           @db.VarChar(80)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(280)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(120)
  description     String?          @db.VarChar(280)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String           @map("membership_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model BranchAccess {
  membershipId String            @map("membership_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  accessLevel  BranchAccessLevel @default(OPERATE) @map("access_level")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   TenantMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("branch_access")
}

model Device {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  branchId     String?      @map("branch_id") @db.Uuid
  name         String       @db.VarChar(120)
  type         DeviceType
  status       DeviceStatus @default(PENDING)
  registeredAt DateTime     @default(now()) @map("registered_at") @db.Timestamptz(6)
  lastSeenAt   DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId, branchId, status])
  @@map("devices")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  deviceId     String?  @map("device_id") @db.Uuid
  action       String   @db.VarChar(160)
  entityType   String   @map("entity_type") @db.VarChar(120)
  entityId     String?  @map("entity_id") @db.Uuid
  reason       String?  @db.VarChar(280)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  eventType      String            @map("event_type") @db.VarChar(160)
  eventVersion   Int               @default(1) @map("event_version")
  aggregateType  String            @map("aggregate_type") @db.VarChar(120)
  aggregateId    String            @map("aggregate_id") @db.Uuid
  correlationId  String            @map("correlation_id") @db.Uuid
  causationId    String?           @map("causation_id") @db.Uuid
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  occurredAt     DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId, branchId, occurredAt])
  @@map("outbox_events")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String         @db.VarChar(160)
  slug        String         @db.VarChar(180)
  description String?        @db.VarChar(500)
  sortOrder   Int            @default(0) @map("sort_order")
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  categoryId  String           @map("category_id") @db.Uuid
  name        String           @db.VarChar(180)
  slug        String           @db.VarChar(200)
  description String?          @db.VarChar(800)
  sku         String?          @db.VarChar(80)
  barcode     String?          @db.VarChar(80)
  status      ProductStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]

  @@unique([tenantId, slug])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, deletedAt])
  @@map("products")
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  name           String               @db.VarChar(180)
  sku            String?              @db.VarChar(80)
  barcode        String?              @db.VarChar(80)
  priceCents     Int                  @default(0) @map("price_cents")
  currency       String               @default("USD") @db.Char(3)
  trackInventory Boolean              @default(true) @map("track_inventory")
  sortOrder      Int                  @default(0) @map("sort_order")
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@index([tenantId, productId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, deletedAt])
  @@map("product_variants")
}

model InventoryItem {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  productVariantId String              @map("product_variant_id") @db.Uuid
  name             String              @db.VarChar(180)
  sku              String?             @db.VarChar(80)
  barcode          String?             @db.VarChar(80)
  unit             String              @default("unit") @db.VarChar(40)
  quantityOnHand   Decimal             @default(0) @map("quantity_on_hand") @db.Decimal(14, 3)
  reorderPoint     Decimal?            @map("reorder_point") @db.Decimal(14, 3)
  status           InventoryItemStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]

  @@unique([tenantId, branchId, productVariantId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, name])
  @@index([tenantId, branchId, sku])
  @@index([tenantId, branchId, barcode])
  @@index([tenantId, branchId, deletedAt])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  branchId        String                  @map("branch_id") @db.Uuid
  inventoryItemId String                  @map("inventory_item_id") @db.Uuid
  type            InventoryMovementType
  status          InventoryMovementStatus @default(POSTED)
  quantity        Decimal                 @db.Decimal(14, 3)
  unitCostCents   Int?                    @map("unit_cost_cents")
  reason          String?                 @db.VarChar(280)
  referenceType   String?                 @map("reference_type") @db.VarChar(80)
  referenceId     String?                 @map("reference_id") @db.Uuid
  metadata        Json?
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?               @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, type])
  @@index([tenantId, branchId, status])
  @@index([tenantId, inventoryItemId])
  @@index([tenantId, branchId, deletedAt])
  @@map("inventory_movements")
}
