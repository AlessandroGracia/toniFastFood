NODE_ENV=development

# External PostgreSQL server used for local development without Docker.
# Replace host, database, user and password with values provisioned on your physical server.
DATABASE_URL=postgresql://TONIOS_DB_USER:TONIOS_DB_PASSWORD@postgres.example.internal:5432/tonios_dev?schema=public

# External Redis server used by cache, rate limits and future realtime coordination.
REDIS_URL=redis://redis.example.internal:6379

# External NATS server with JetStream enabled.
NATS_URL=nats://nats.example.internal:4222

API_PORT=3001
ADMIN_WEB_PORT=3000
POS_WEB_PORT=3002
KDS_WEB_PORT=3003

# Browser-facing API base URL for the web apps.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Comma-separated list of allowed browser origins for the NestJS API.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003
